<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ADTPro" parent="android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowBackground">@color/adt_black</item>

        <item name="android:navigationBarColor">@color/adt_black</item>

        <item name="android:statusBarColor">@color/adt_black</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:colorAccent">@color/adt_teal</item>

        <!-- خلفية شاشة البداية -->
        <item name="android:windowSplashScreenBackground">@color/adt_black</item>

        <!-- الصورة الكاملة لواجهة البداية -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/adt_splash</item>

        <!-- منع ظهور أي خلفية بيضاء خلف الصورة -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/adt_black</item>

    </style>

</resources>